{
  "name": "bochaswitcher-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker runs first so www → bare-domain redirects also apply to pages
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "bochaswitcher.com", "custom_domain": true },
    { "pattern": "www.bochaswitcher.com", "custom_domain": true }
  ],
  "observability": { "enabled": false }
}
